
@model User
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f6fa;
        }

        .sidebar {
            height: 100vh;
            background: #1e1e2f;
            color: white;
            padding: 20px;
        }

        .sidebar a {
            display: block;
            color: #ccc;
            padding: 10px;
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .sidebar a:hover {
            background: #343a40;
            color: white;
        }

        .avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
        }

        .content {
            padding: 30px;
        }

        .card-markdown {
            border: none;
            border-radius: 15px;
            transition: 0.2s;
        }

        .card-markdown:hover {
            transform: translateY(-5px);
        }
    </style>
</head>

<body>

@if (User.Identity != null && User.Identity.IsAuthenticated && Model!=null)
{
<div class="container-fluid">
    <div class="row">

        <!-- 左側 Sidebar -->
        <div class="col-md-3 col-lg-2 sidebar">

            <div class="text-center mb-4">
                <img src="@Model.AvatarPath" class="avatar mb-2" />
                <h5>@User.Identity.Name</h5>
            </div>

            <a href="javascript:void(0)" onclick="openModal()">➕ 新增 Markdown</a>
            <a href="/User/Profile">⚙️ 使用者設定</a>
            <a onclick="Logout()">🚪 登出</a>

        </div>

        <!-- 右側內容 -->
        <div class="col-md-9 col-lg-10 content">

            <h2 class="mb-4">📚 我的 Markdown</h2>

            <div class="row g-4">

                @* 假設之後你會改成 IEnumerable<Markdown> *@
                @for (int i = 0; i < 6; i++)
                {
                    <div class="col-md-4">
                        <div class="card card-markdown shadow-sm p-3">

                            <h5>Markdown Title @i</h5>
                            <p class="text-muted">
                                這是一段簡短描述...
                            </p>

                            <div class="d-flex justify-content-between">
                                <a href="#" class="btn btn-sm btn-outline-primary">查看</a>
                                <a href="#" class="btn btn-sm btn-outline-secondary">編輯</a>
                            </div>

                        </div>
                    </div>
                }

            </div>

        </div>

    </div>
</div>

<script>
function Logout(){
    if(confirm("確定要登出嗎？")){
        window.location.href = "/UserPage/Logout";
    }
}
</script>



<!-- Modal -->
<div id="AddMarkdown" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal()">&times;</span>

        <h2>新增 Markdown</h2>

        <form asp-controller="UserPage" asp-action="AddNewMarkdown" method="post">
            <div class="form-group">
                <label>標題</label>
                <input type="text" name="Title" class="form-control" value="" required />
            </div>

            <div class="form-group">
                <label>文章摘要</label>
                <textarea name="Preview" rows="5" class="form-control" value="" required></textarea>
            </div>

            <div class="form-group">
                <div>
                    <input type="checkbox" name="PublicSetting" value="True" checked />
                    <label for="PublicSetting">公開筆記</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                新增
            </button>
        </form>
    </div>
</div>

<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4);
    }

    .modal-content {
        background-color: white;
        margin: 8% auto;
        padding: 20px;
        width: 60%;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
    }

    .close {
        float: right;
        font-size: 28px;
        cursor: pointer;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }
</style>

<script>
    function openModal() {
        document.getElementById("AddMarkdown").style.display = "block";
    }

    function closeModal() {
        document.getElementById("AddMarkdown").style.display = "none";
    }

    // 點擊外部關閉
    window.onclick = function (event) {
        const modal = document.getElementById("AddMarkdown");

        if (event.target === modal) {
            closeModal();
        }
    }
</script>


}

</body>
</html>